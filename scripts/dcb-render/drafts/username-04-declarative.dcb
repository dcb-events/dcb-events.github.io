model "Unique username (declarative, with retention)"

tag type Username = string
type Day = integer

event AccountRegistered { username: Username }
// The closing/renaming side records until when the released name stays reserved.
event AccountClosed { username: Username, reservedUntil: Day }
event UsernameChanged { oldUsername: Username, newUsername: Username, reservedUntil: Day }

// Who currently holds the name of this partition (null = nobody).
projection UsernameHolder(username: Username): Username = null {
  on AccountRegistered => set event.data.username
  on AccountClosed => set null
  on UsernameChanged => set event.data.newUsername
}

projection UsernameReservedUntil(username: Username): Day = 0 {
  on AccountClosed => set event.data.reservedUntil
  on UsernameChanged => set event.data.reservedUntil
}

command RegisterAccount(username: Username, today: Day) {
  read holder = UsernameHolder(username)
  read reservedUntil = UsernameReservedUntil(username)

  require holder != username
  require reservedUntil < today

  emit AccountRegistered { username }

  scenario "claimed" {
    given AccountRegistered { username: "u1" }
    when RegisterAccount { username: "u1", today: 10 }
    then rejected by holder != username
  }
  scenario "unused" {
    when RegisterAccount { username: "u1", today: 10 }
    then AccountRegistered { username: "u1" }
  }
  scenario "closed, within retention" {
    given AccountRegistered { username: "u1" }
    given AccountClosed { username: "u1", reservedUntil: 10 }
    when RegisterAccount { username: "u1", today: 10 }
    then rejected by reservedUntil < today
  }
  scenario "changed, within retention" {
    given AccountRegistered { username: "u1" }
    given UsernameChanged { oldUsername: "u1", newUsername: "u1changed", reservedUntil: 10 }
    when RegisterAccount { username: "u1", today: 10 }
    then rejected by reservedUntil < today
  }
  scenario "closed, after retention" {
    given AccountRegistered { username: "u1" }
    given AccountClosed { username: "u1", reservedUntil: 9 }
    when RegisterAccount { username: "u1", today: 10 }
    then AccountRegistered { username: "u1" }
  }
  scenario "changed, after retention" {
    given AccountRegistered { username: "u1" }
    given UsernameChanged { oldUsername: "u1", newUsername: "u1changed", reservedUntil: 9 }
    when RegisterAccount { username: "u1", today: 10 }
    then AccountRegistered { username: "u1" }
  }
  scenario "name another was changed to" {
    given AccountRegistered { username: "u1" }
    given UsernameChanged { oldUsername: "u1", newUsername: "u1changed", reservedUntil: 9 }
    when RegisterAccount { username: "u1changed", today: 10 }
    then rejected by holder != username
  }
}
